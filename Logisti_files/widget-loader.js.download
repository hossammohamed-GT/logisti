 */(function(){"use strict";const $=`
  .wp-skel{background:linear-gradient(90deg,#eaecf0 25%,#f2f4f7 50%,#eaecf0 75%);background-size:200% 100%;animation:wp-shimmer 1.5s ease infinite;border-radius:4px;display:block}
  .wp-skel-circle{border-radius:50%}
  @keyframes wp-shimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}
  .wp-header{position:fixed;top:0;inset-inline:0;z-index:999;background:#fff;box-shadow:0 1px 3px rgba(16,24,40,.06)}
  .wp-stamp{background:#f2f4f7;padding:4px 0;min-height:30px;display:flex;align-items:center}
  .wp-container{width:100%;max-width:1320px;margin:0 auto;padding:0 16px}
  .wp-stamp-inner{display:flex;align-items:center;gap:10px;min-height:30px}
  .wp-topbar{display:flex;align-items:center;justify-content:space-between;min-height:50px}
  .wp-brand{display:flex;align-items:center;flex-shrink:0}
  .wp-logo{height:35px;width:auto}
  .wp-nav{display:flex;gap:20px;align-items:center;flex:1;padding-inline-start:24px}
  .wp-actions{display:flex;gap:14px;align-items:center}
  .wp-footer{background:#f9fafb;border-top:1px solid #eaecf0}
  .wp-footer-cols{display:grid;grid-template-columns:repeat(4,1fr);gap:32px;padding:40px 0}
  .wp-footer-col-title{margin-bottom:14px}
  .wp-footer-col-links{display:flex;flex-direction:column;gap:8px}
  .wp-footer-social{display:flex;gap:8px;margin-top:12px}
  .wp-footer-bottom{display:flex;align-items:center;justify-content:space-between;padding:16px 0;border-top:1px solid #eaecf0}
  .wp-footer-copy{display:flex;flex-direction:column;gap:4px}
  .wp-content-skel{background:#fff}
  @media(max-width:767px){.wp-content-skel .wp-container{flex-wrap:wrap!important;gap:8px!important}.wp-content-skel .wp-container>div{width:100%}}
  .lw-no-container .lw-container,.wp-header .wp-container{max-width:none}
  html{min-height:100vh}
  body{padding-top:80px;min-height:100vh;display:flex;flex-direction:column}
  body>*:not(header):not(footer):not(script):not(style):not(link){flex:1}
  #widget-footer-placeholder{margin-top:auto}
